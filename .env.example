# --- Publieke site ---
NEXT_PUBLIC_SITE_URL=https://www.nkgc.nl

# Contactformulier (server-side verzending, bv. via Resend/Postmark/SMTP)
CONTACT_FORM_TO_EMAIL=info@nkgc.nl
CONTACT_FORM_FROM_EMAIL=
EMAIL_PROVIDER_API_KEY=

# --- MijnNKGC integratielaag (src/lib/mijnnkgc) ---
# Nog onbekend / af te stemmen met NKGC + GMWconsult, zie docs/MIJNNKGC_INTEGRATION.md
MIJNNKGC_API_BASE_URL=
MIJNNKGC_API_KEY=
MIJNNKGC_SESSION_SECRET=

# Zet op "1" om de MijnNKGC-integratielaag in mock/fixture-modus te draaien
# tijdens development. Nooit gebruiken in productie.
MIJNNKGC_USE_DEV_FIXTURES=1
